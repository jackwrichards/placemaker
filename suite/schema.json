    "area": { "keys": ["tool", "at", "shift", "points", "rect", "stroke", "size", "square", "angle", "nodes", "abs", "cameraDistance"], "enums": { "tool": ["bucket", "block", "points", "draw", "land", "paint", "paintAnything", "nodes", "perimeter"] } },
    "clear": { "keys": [] },
    "hover": { "keys": ["tool", "at", "abs", "seconds"], "enums": { "tool": ["bucket", "block", "paint", "points", "draw"] } },
    "type": { "keys": ["layer", "preset", "fresh"] },
    "preset": { "keys": ["layer", "preset"] },
    "value": { "keys": ["path", "id", "value", "json"] },
    "entrance": { "keys": ["side", "t", "at", "abs", "path", "kind"], "enums": { "side": ["south", "east", "north", "west"] } },
    "entrances": { "keys": [] },
    "moveEntrance": { "keys": ["index", "side", "t", "at", "abs"], "enums": { "side": ["south", "east", "north", "west"] } },
    "removeEntrance": { "keys": ["index"] },
    "preview": { "keys": [] },
    "previewMode": { "keys": ["mode"], "enums": { "mode": ["sketch", "ghost"] } },
    "edit": { "keys": ["build"] },
    "build": { "keys": ["when", "via"], "enums": { "when": ["settled", "planReady", "ghostPending"], "via": ["panel", "enter"] } },
    "select": { "keys": [] },
    "delete": { "keys": [] },
    "bulldoze": { "keys": ["target"], "enums": { "target": ["owner", "part"] } },
    "infoEdit": { "keys": [] },
    "infoRemove": { "keys": [] },
    "camera": { "keys": ["target", "view", "index", "yaw", "pitch", "distance", "fov", "at", "abs"] },
    "shot": { "keys": ["name"] },
    "terrain": { "keys": ["name", "margin"] },
    "wait": { "keys": ["seconds", "frames"] },
    "grow": { "keys": ["seconds", "fast"] },
    "undo": { "keys": ["via"], "enums": { "via": ["key", "panel"] } },
    "redo": { "keys": ["via"], "enums": { "via": ["key", "panel"] } },
    "key": { "keys": ["key"], "enums": { "key": ["enter", "esc", "undo", "redo"] } },
    "anarchy": { "keys": ["on"] },
    "setting": { "keys": ["name", "value"] }
  },
  "camera": {
    "keys": ["target", "view", "index", "yaw", "pitch", "distance", "fov", "at", "abs"],
