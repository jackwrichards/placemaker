    "enums": { "shape": ["rect", "square", "rectangle", "circle", "pinch", "l", "points"], "ground": ["flat", "slope", "hills", "bumpy", "mountains", "heights"], "toward": ["north", "south", "east", "west"], "roads": ["around", "none", "follow"] }
  },
