{
  "_about": "The game runner's scenario and step vocabulary. Checked by Send-Suite.ps1 before sending, and by the game (SuiteSchema) for every set and step. Unknown keys, steps and enum values are errors; keys starting with '_' are comments. suite/README.md explains each key.",
  "scenarioKeys": ["id", "layer", "preset", "expand", "group", "site", "block", "streets", "siteFallback", "draw", "values", "seed", "note", "skip", "limit", "steps", "on", "pace", "buildWhen", "previewMode", "land"],
  "scenarioEnums": {
    "site": ["flat", "zoned", "slope", "rough", "survive", "any"],
    "expand": ["presets", "types"],
    "pace": ["human", "settled", "user"],
    "buildWhen": ["settled", "planReady", "ghostPending"],
    "previewMode": ["sketch", "ghost"]
  },
  "land": {
