{
  "_about": "Coarse asphalt strips in the Real preview: speed on a big car park, the look on a block. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/siteplan-coarse.json -Build -Who sketch-view",
  "scenarios": [
    {
      "id": "spcoarse-big",
      "pace": "settled",
      "land": {
        "shape": "rect",
        "size": [
          460,
          340
        ],
        "gap": 10
      },
      "steps": [
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "parking",
          "preset": "standard"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
        {
          "do": "previewMode",
          "mode": "ghost"
        },
        {
          "do": "wait",
          "seconds": 4
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "pitch": 45,
          "shot": "real-45",
          "shotMode": "overlay"
        },
        {
          "do": "wait",
          "seconds": 5
        },
        {
          "do": "camera",
          "target": "area",
          "view": "closeup",
          "shot": "real-close",
          "shotMode": "overlay"
        },
        {
          "do": "wait",
          "seconds": 5
        }
      ]
    },
    {
      "id": "spcoarse-block",
      "pace": "settled",
      "site": "flat",
      "steps": [
        {
          "do": "area",
          "tool": "bucket"
        },
        {
          "do": "type",
          "layer": "parking",
          "preset": "standard"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
        {
          "do": "previewMode",
          "mode": "ghost"
        },
        {
          "do": "wait",
          "seconds": 4
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "pitch": 45,
          "shot": "real-45",
          "shotMode": "overlay"
        },
        {
          "do": "camera",
          "target": "area",
          "view": "closeup",
          "shot": "real-close",
          "shotMode": "overlay"
        },
        {
          "do": "previewMode",
          "mode": "sketch"
        },
        {
          "do": "wait",
          "seconds": 2
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "pitch": 45,
          "shot": "sketch-45",
          "shotMode": "overlay"
        }
      ]
    }
  ]
}