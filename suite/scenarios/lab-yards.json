{
  "_about": "Lab (exploration): yard stitching on grown houses (Game/Suite/SuiteLab.Yards.cs) on a curved and a straight street, before and after pictures from the same cameras; then the generated-shapes spike (lab-shapes.json). Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/lab-yards.json -Build -Who lab-yards",
  "scenarios": [
    {
      "id": "yards-curve",
      "land": { "shape": "rect", "size": [380, 300], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "lab", "op": "street", "shape": "arc", "radius": 90, "from": 0, "to": 180 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-45", "camera": { "target": "area", "view": "oblique" }, "shotMode": "render" },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" }, "shotMode": "render" },
        { "do": "lab", "op": "yards", "reach": 10, "closeups": 3 },
        { "do": "shot", "name": "after-45", "camera": { "target": "area", "view": "oblique" }, "shotMode": "render" },
        { "do": "shot", "name": "after-top", "camera": { "target": "area", "view": "top" }, "shotMode": "render" },
        { "do": "grow", "seconds": 30 },
        { "do": "lab", "op": "yardsCheck" }
      ]
    },
    {
      "id": "yards-straight",
      "land": { "shape": "rect", "size": [300, 220], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "lab", "op": "street", "shape": "straight", "length": 240 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-45", "camera": { "target": "area", "view": "oblique" }, "shotMode": "render" },
        { "do": "lab", "op": "yards", "reach": 10, "closeups": 2 },
        { "do": "shot", "name": "after-45", "camera": { "target": "area", "view": "oblique" }, "shotMode": "render" }
      ]
    },
    {
      "id": "lab-shapes",
      "land": { "shape": "rect", "size": [180, 140], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "lab", "op": "materials" },
        { "do": "lab", "op": "mesh", "shape": "box", "size": [16, 20], "height": 12, "at": [-50, -10] },
        { "do": "lab", "op": "mesh", "shape": "wedge", "size": [22, 26], "height": 10, "at": [-15, -10] },
        { "do": "lab", "op": "mesh", "shape": "arch", "size": [26, 26], "height": 16, "at": [22, -10], "yaw": 20 },
        { "do": "lab", "op": "mesh", "shape": "tower", "size": [14, 14], "height": 34, "at": [55, -10] },
        { "do": "lab", "op": "mesh", "shape": "polygon", "points": [[0, 0], [30, 0], [36, 10], [24, 22], [6, 18]], "height": 7, "at": [0, 30] },
        { "do": "shot", "name": "shapes-45", "camera": { "target": "area", "view": "oblique" }, "shotMode": "render" },
        { "do": "shot", "name": "shapes-low", "camera": { "target": "area", "view": "low" }, "shotMode": "render" },
        { "do": "shot", "name": "wedge-close", "camera": { "target": "point", "at": [-15, -10], "view": "closeup", "distance": 55 }, "shotMode": "render" }
      ]
    }
  ]
}
