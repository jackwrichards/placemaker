{
  "_about": "Site plan objects as rough models (the user, 25 Oct: every object modelled, cars, junk): the sketch and the build for six types with many kinds of objects. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/siteplan-props.json -Build -Who sketch-view",
  "scenarios": [
    {
      "id": "spprops-carYard",
      "pace": "settled",
      "site": "flat",
      "steps": [
        {
          "do": "area",
          "tool": "bucket"
        },
        {
          "do": "type",
          "layer": "carYard",
          "preset": "salvage"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
        {
          "do": "previewMode",
          "mode": "sketch"
        },
        {
          "do": "wait",
          "seconds": 2
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "pitch": 50,
          "shot": "sketch-45",
          "shotMode": "overlay"
        },
        {
          "do": "build"
        },
        {
          "do": "camera",
          "target": "build",
          "view": "oblique",
          "pitch": 50,
          "shot": "built-45",
          "shotMode": "render"
