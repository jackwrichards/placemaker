{
  "_about": "Outgrow's city switches (the user: new buildings off by default everywhere, saved per city, a master switch that only pauses). A fresh city grows a suburb with nothing set: no building may outgrow. New buildings on: the next ones do. Master off: no new one does, the outgrown ones stay. Saved and loaded: both switches come back as they were. Then the City window with the master switch. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/outgrow-switches.json -Who outgrow-switches",
  "scenarios": [
    {
      "id": "outgrow-switches",
      "land": {
        "shape": "rect",
        "size": [
          420,
          340
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        {
          "do": "lab",
          "op": "polishStats"
        },
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "roads",
          "preset": "suburb"
        },
        {
          "do": "value",
          "path": "0",
          "id": "preZone",
          "json": "\"residentialLow\""
        },
        {
          "do": "build"
        },
        {
          "do": "grow",
          "seconds": 3
        },
        {
          "do": "lab",
          "op": "polishFlags"
        },
        {
          "do": "shot",
          "name": "default-off",
          "camera": {
            "target": "area",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "polish",
          "city": "newHouses",
          "value": "true"
        },
        {
          "do": "grow",
          "seconds": 3
        },
        {
          "do": "lab",
          "op": "polishIdle"
        },
        {
          "do": "lab",
          "op": "polishFlags"
        },
        {
          "do": "shot",
          "name": "new-on",
          "camera": {
            "target": "area",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "polish",
          "city": "on",
          "value": "false"
        },
        {
          "do": "grow",
          "seconds": 15
        },
        {
          "do": "lab",
          "op": "polishFlags"
        },
        {
          "do": "lab",
          "op": "polishStats"
        },
        {
          "do": "shot",
          "name": "paused",
          "camera": {
            "target": "area",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "lab",
          "op": "saveLoad"
        },
        {
          "do": "lab",
          "op": "polishStats"
        },
        {
          "do": "lab",
          "op": "polishFlags"
        },
        {
          "do": "area",
          "tool": "paint",
          "size": 60,
          "cameraDistance": 520,
          "stroke": [
            [
              -110,
              -60
            ],
            [
              -60,
              0
            ],
            [
              -20,
              40
            ]
          ]
        },
        {
          "do": "type",
          "layer": "polishGarden",
          "preset": "standard"
        },
        {
          "do": "polish",
          "click": "panel-mode-outgrow"
        },
        {
          "do": "shot",
          "name": "city-ui",
          "shotMode": "ui"
        }
      ]
    }
  ]
}
