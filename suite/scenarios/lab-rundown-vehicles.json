{
  "_about": "Lab (rundown makeover): do Placemaker's own vehicle props (VehicleProps, made at load from the game's vehicles) place in a lineup, and does a construction site built right after show them. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/lab-rundown-vehicles.json -Who makeover-rundown",
  "scenarios": [
    {
      "id": "vehicle-props",
      "land": { "shape": "rect", "size": [100, 60], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "lab", "op": "lineup", "names": ["Placemaker Vehicle Loader 1", "Placemaker Vehicle Truck 1", "Placemaker Vehicle Tractor 1", "Placemaker Vehicle Tractor 2", "Placemaker Vehicle Car 2"], "perRow": 5, "gap": 4 },
        { "do": "shot", "name": "low", "camera": { "target": "area", "view": "low" }, "shotMode": "render" }
      ]
    },
    {
      "id": "site-machines",
      "site": "flat",
      "pace": "settled",
      "land": { "size": [150, 140], "gap": 10 },
      "steps": [
        { "do": "area", "tool": "land" },
        { "do": "type", "layer": "constructionSite", "preset": "earthworks" },
        { "do": "entrances" },
        { "do": "build" },
        { "do": "camera", "target": "build", "view": "oblique", "pitch": 45, "shot": "45", "shotMode": "render" }
      ]
    }
  ]
}
