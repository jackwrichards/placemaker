{
  "_about": "AI builder car parks on Sonnet 5.5 medium (handbook-4: the premade car park recipe and kit)",
  "scenarios": [
    {
      "id": "ai-sonnet-parking",
      "land": {
        "shape": "rect",
        "size": [
          140,
          110
        ],
        "ground": "flat",
        "roads": "around",
        "gap": 10
      },
      "steps": [
        {
          "do": "setting",
          "name": "AiBuilderOn",
          "value": true
        },
        {
          "do": "setting",
          "name": "AiModel",
          "value": "anthropic/claude-sonnet-5.5"
        },
        {
          "do": "setting",
          "name": "AiThinking",
          "value": 1
        },
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "ai"
        },
        {
          "do": "aiAgent",
          "prompt": "A car park for about 60 cars, with trees and lamps, entered from the street.",
          "timeout": 600
        },
        {
          "do": "build"
        },
        {
          "do": "shot",
          "name": "45-built",
          "camera": {
            "target": "build",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "shot",
          "name": "top-built",
          "camera": {
            "target": "build",
            "view": "top"
          },
          "shotMode": "render"
        },
        {
          "do": "terrain",
          "name": "terrain"
        }
      ]
    },
    {
      "id": "ai-sonnet-parking-big",
      "land": {
        "shape": "rect",
        "size": [
          140,
          110
        ],
        "ground": "flat",
        "roads": "around",
        "gap": 10
      },
      "steps": [
        {
          "do": "setting",
          "name": "AiBuilderOn",
          "value": true
        },
        {
          "do": "setting",
          "name": "AiModel",
          "value": "anthropic/claude-sonnet-5.5"
        },
        {
          "do": "setting",
          "name": "AiThinking",
          "value": 1
        },
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "ai"
        },
        {
          "do": "aiAgent",
          "prompt": "A large car park for a shopping centre.",
          "timeout": 600
        },
        {
          "do": "build"
        },
        {
          "do": "shot",
          "name": "45-built",
          "camera": {
            "target": "build",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "shot",
          "name": "top-built",
          "camera": {
            "target": "build",
            "view": "top"
          },
          "shotMode": "render"
        },
        {
          "do": "terrain",
          "name": "terrain"
        },
        {
          "do": "setting",
          "name": "AiBuilderOn",
          "value": false
        },
        {
          "do": "setting",
          "name": "AiModel",
          "value": "anthropic/claude-sonnet-5.5"
        },
        {
          "do": "setting",
          "name": "AiThinking",
          "value": 1
        }
      ]
    }
  ]
}
