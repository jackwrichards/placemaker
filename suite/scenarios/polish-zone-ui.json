{
  "_about": "The Zoning types' panel: Zoning (zones for the empty land: the zone editor, lots from the road with width and depth) then Shape (how the lots grow). An unzoned street, its land picked, the Garden look, a second zone mixed in, its menu, Review with the cells per zone. Send with tools/hot/Send-Hot.ps1 -File suite/scenarios/polish-zone-ui.json.",
  "scenarios": [
    {
      "id": "polish-zone-ui",
      "land": {
        "shape": "rect",
        "size": [
          320,
          240
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        {
          "do": "lab",
          "op": "street",
          "shape": "arc",
          "radius": 120,
          "from": 40,
          "to": 140,
          "zone": "none"
        },
        {
          "do": "area",
          "tool": "paint",
          "size": 80,
          "cameraDistance": 520,
          "stroke": [
            [
              -110,
              -60
            ],
            [
              -60,
              0
            ],
            [
              -20,
              40
            ],
            [
              30,
              60
            ]
          ]
        },
        {
          "do": "type",
          "layer": "zoningSuburb",
          "preset": "suburbCornerShops"
        },
        {
          "do": "shot",
          "name": "zone-one-ui",
          "shotMode": "ui"
        },
        {
          "do": "polish",
          "click": "zonemix-add"
        },
        {
          "do": "wait",
          "seconds": 2
        },
        {
          "do": "shot",
          "name": "zone-two-ui",
          "shotMode": "ui"
        },
        {
          "do": "polish",
          "click": "zonemix-pick-A"
        },
        {
          "do": "shot",
          "name": "zone-menu-ui",
          "shotMode": "ui"
        },
        {
          "do": "polish",
          "click": "zonemix-pick-A"
        },
        {
          "do": "preview"
        },
        {
          "do": "shot",
          "name": "review-ui",
          "shotMode": "ui"
        }
      ]
    }
  ]
}
