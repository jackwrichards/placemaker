{
 "_about": "Lab: a line-up of the game's own ground pieces (rocks, boulders, heaps, loads, rubble, logs, trash, anything else earthy), two pictures each (Game/Suite/SuiteLab.Lineup.cs). Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/lab-ground.json -Who industrial-ground",
 "scenarios": [
  {
   "id": "ground-rocks",
   "land": {
    "shape": "rect",
    "size": [
     200,
     160
    ],
    "ground": "flat",
    "roads": "none"
   },
   "steps": [
    {
     "do": "lab",
     "op": "lineup",
     "match": "^Rock\\d+$",
     "max": 30,
     "perRow": 6,
     "gap": 3
    },
    {
     "do": "shot",
     "name": "oblique",
     "camera": {
      "target": "area",
      "view": "oblique"
     },
     "shotMode": "render"
    },
    {
     "do": "shot",
     "name": "top",
     "camera": {
      "target": "area",
      "view": "top"
     },
     "shotMode": "render"
    }
   ]
  },
  {
