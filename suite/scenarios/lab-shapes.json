{
  "_about": "Lab (exploration): brand-new 3D objects generated in code while the game runs (Game/Suite/SuiteLabShapeSystem.cs), each its own new prefab, placed like vanilla props. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/lab-shapes.json -Build -Who lab-shapes",
  "scenarios": [
    {
      "id": "lab-shapes",
      "land": { "shape": "rect", "size": [180, 140], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "lab", "op": "materials" },
        { "do": "lab", "op": "mesh", "shape": "box", "size": [16, 20], "height": 12, "at": [-50, -10] },
        { "do": "lab", "op": "mesh", "shape": "wedge", "size": [22, 26], "height": 10, "at": [-15, -10] },
        { "do": "lab", "op": "mesh", "shape": "arch", "size": [26, 26], "height": 16, "at": [22, -10], "yaw": 20 },
        { "do": "lab", "op": "mesh", "shape": "tower", "size": [14, 14], "height": 34, "at": [55, -10] },
        { "do": "lab", "op": "mesh", "shape": "polygon", "points": [[0, 0], [30, 0], [36, 10], [24, 22], [6, 18]], "height": 7, "at": [0, 30] },
        { "do": "shot", "name": "shapes-45", "camera": { "target": "area", "view": "oblique" }, "shotMode": "render" },
        { "do": "shot", "name": "shapes-top", "camera": { "target": "area", "view": "top" }, "shotMode": "render" },
        { "do": "shot", "name": "shapes-low", "camera": { "target": "area", "view": "low" }, "shotMode": "render" },
        { "do": "shot", "name": "wedge-close", "camera": { "target": "point", "at": [-15, -10], "view": "closeup", "distance": 55 }, "shotMode": "render" }
      ]
    }
  ]
}
