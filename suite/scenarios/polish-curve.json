{
  "_about": "Neighbourhood polish on a curved street, inside and outside, then every house's fence lines rebuilt by the game (the polish must put its edits back). Short on purpose: one scenario, few pictures. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/polish-curve.json -Build -Who polish",
  "scenarios": [
    {
      "id": "polish-curve",
      "land": {
        "shape": "rect",
        "size": [
          380,
          300
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "arc", "radius": 90, "from": 0, "to": 180 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "shot", "name": "before-inner", "camera": { "target": "point", "at": [ 0, 20 ], "view": "oblique", "pitch": 50, "distance": 80 },
          "shotMode": "render"
        },
        { "do": "shot", "name": "before-inner2", "camera": { "target": "point", "at": [ -42, 2 ], "view": "oblique", "pitch": 50, "distance": 80 },
          "shotMode": "render"
        },
        { "do": "shot", "name": "before-outer", "camera": { "target": "point", "at": [ 0, 80 ], "view": "oblique", "pitch": 45, "distance": 85 },
          "shotMode": "render"
        },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "lab", "op": "polishStamp", "yes": true },
        { "do": "wait", "seconds": 2 },
        { "do": "lab", "op": "polishStats" },
        { "do": "shot", "name": "after-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "shot", "name": "after-inner", "camera": { "target": "point", "at": [ 0, 20 ], "view": "oblique", "pitch": 50, "distance": 80 },
          "shotMode": "render"
        },
        { "do": "shot", "name": "after-inner2", "camera": { "target": "point", "at": [ -42, 2 ], "view": "oblique", "pitch": 50, "distance": 80 },
          "shotMode": "render"
        },
        { "do": "shot", "name": "after-outer", "camera": { "target": "point", "at": [ 0, 80 ], "view": "oblique", "pitch": 45, "distance": 85 },
          "shotMode": "render"
        },
        { "do": "lab", "op": "touchHouses" },
        { "do": "wait", "seconds": 2 },
        { "do": "lab", "op": "polishStats" },
        { "do": "shot", "name": "rebuilt-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        }
      ]
    },
    {
      "id": "polish-straight",
      "land": {
        "shape": "rect",
        "size": [
          300,
          220
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "straight", "length": 240 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "shot", "name": "before-45", "camera": { "target": "point", "at": [ -20, 32 ], "view": "oblique", "pitch": 45, "distance": 85 },
          "shotMode": "render"
        },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "lab", "op": "polishStamp", "yes": true },
        { "do": "wait", "seconds": 2 },
        { "do": "lab", "op": "polishStats" },
        { "do": "shot", "name": "after-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "shot", "name": "after-45", "camera": { "target": "point", "at": [ -20, 32 ], "view": "oblique", "pitch": 45, "distance": 85 },
          "shotMode": "render"
        }
      ]
    }
  ]
}
