{
  "_about": "AI builder against the premade types (tools/suite/ai-vs-types.js): per type its default style, then the AI given one plain request, on the same land. Round 2: the shore types on land with a lake to the north.",
  "scenarios": [
    {
      "id": "type-beach",
      "land": {
        "shape": "rect",
        "size": [
          140,
          110
        ],
        "ground": "flat",
        "roads": "around",
        "gap": 10,
        "water": "north"
      },
      "steps": [
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "beach"
        },
        {
          "do": "entrances"
        },
        {
          "do": "build"
        },
        {
          "do": "shot",
          "name": "45-built",
