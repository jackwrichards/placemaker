{
  "_about": "Neighbourhood polish on every street shape in one launch: a tight curve (R 50), a gentle curve (R 170), a full circle (houses inside meet at the centre like pie slices), a square block (houses back to back in the middle). Before/after from above and one close-up each. Send with tools/hot/Send-Hot.ps1 -File suite/scenarios/polish-shapes.json (-Build after a mod change).",
  "scenarios": [
    {
      "id": "shape-tight",
      "land": {
        "shape": "rect",
        "size": [
          240,
          200
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        { "do": "lab", "op": "hotload", "path": "{hot}" },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "arc", "radius": 50, "from": 0, "to": 180 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "lab", "op": "polishStamp", "yes": true },
        { "do": "wait", "seconds": 4 },
        { "do": "lab", "op": "polishStats" },
        { "do": "lab", "op": "polishDump" },
        { "do": "shot", "name": "after-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "shot", "name": "after-45", "camera": { "target": "point", "at": [ 0, 40 ], "view": "oblique", "pitch": 50, "distance": 110 },
          "shotMode": "render"
        }
      ]
    },
    {
      "id": "shape-gentle",
      "land": {
        "shape": "rect",
        "size": [
          440,
          260
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "arc", "radius": 170, "from": 30, "to": 150, "at": [ 0, -120 ] },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "lab", "op": "polishStamp", "yes": true },
        { "do": "wait", "seconds": 4 },
        { "do": "lab", "op": "polishStats" },
        { "do": "lab", "op": "polishDump" },
        { "do": "shot", "name": "after-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "shot", "name": "after-45", "camera": { "target": "point", "at": [ 0, 80 ], "view": "oblique", "pitch": 50, "distance": 110 },
          "shotMode": "render"
        }
      ]
    },
    {
      "id": "shape-circle",
      "land": {
        "shape": "rect",
        "size": [
          300,
          300
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "circle", "radius": 75 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "lab", "op": "polishStamp", "yes": true },
        { "do": "wait", "seconds": 4 },
        { "do": "lab", "op": "polishStats" },
