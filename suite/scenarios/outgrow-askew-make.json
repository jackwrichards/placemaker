        { "do": "lab", "op": "polishIdle", "seconds": 240 },
        { "do": "lab", "op": "outgrowQuiet", "seconds": 5 },
        { "do": "lab", "op": "fenceMap", "box": "gardens", "label": "curve", "closeups": 2, "junctions": 6, "edges": 0 },
        { "do": "shot", "name": "curve-top", "camera": { "target": "point", "at": [0, 5], "view": "top", "distance": 300 }, "shotMode": "render" },
        { "do": "shot", "name": "curve-top-east", "camera": { "target": "point", "at": [75, 5], "view": "top", "distance": 170 }, "shotMode": "render" },
        { "do": "shot", "name": "curve-top-west", "camera": { "target": "point", "at": [-75, 5], "view": "top", "distance": 170 }, "shotMode": "render" }
