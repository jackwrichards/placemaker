        { "do": "lab", "op": "street", "shape": "arc", "at": [0, -200], "radius": 165, "from": 40, "to": 140, "zone": "NA Residential Low" },
        { "do": "grow", "seconds": 180 },
        { "do": "lab", "op": "polishIdle", "seconds": 120 },
        { "do": "lab", "op": "saveCity", "name": "PM Askew Curve" },
