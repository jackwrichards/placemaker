        "shape": "rect",
        "size": [
          140,
          110
        ],
        "ground": "flat",
        "roads": "around",
        "gap": 10
      },
      "steps": [
        {
          "do": "setting",
          "name": "AiBuilderOn",
          "value": true
        },
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "ai"
        },
        {
          "do": "aiAgent",
          "prompt": "A neighbourhood park.",
          "timeout": 900
        },
        {
          "do": "build"
        },
        {
          "do": "shot",
          "name": "45-built",
          "camera": {
            "target": "build",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "shot",
          "name": "top-built",
          "camera": {
            "target": "build",
            "view": "top"
