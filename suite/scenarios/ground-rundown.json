{
  "_about": "The rundown category's designed grounds (docs/runbooks/rundown.md): the rubble field (the most instances) on 220 x 200 with frame times before the build, with its ground and with it switched off; then close looks by kind on the old car park, the burnt-out lot, the building ruins and the construction site. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/ground-rundown.json -Who makeover-rundown",
  "scenarios": [
    {
      "id": "rubble-frames",
      "site": "flat",
      "pace": "settled",
      "land": {
        "size": [
          220,
          200
        ],
        "gap": 10
      },
      "steps": [
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "pitch": 45
        },
        {
          "do": "lab",
          "op": "dynFrames",
          "frames": 240,
          "label": "before the build"
        },
        {
          "do": "type",
          "layer": "abandonedLot",
          "preset": "rubbleField"
        },
        {
          "do": "entrances"
        },
        {
          "do": "build"
        },
        {
          "do": "lab",
          "op": "grime"
        },
        {
          "do": "camera",
          "target": "build",
          "view": "oblique",
          "pitch": 45
        },
        {
          "do": "lab",
          "op": "dynFrames",
          "frames": 240,
          "label": "with the ground"
        },
        {
          "do": "camera",
          "target": "build",
          "view": "oblique",
          "pitch": 45,
          "shot": "45",
          "shotMode": "render"
        },
        {
          "do": "wait",
          "seconds": 15
        },
        {
          "do": "lab",
          "op": "dynFrames",
          "frames": 240,
          "label": "with the ground, textures made"
        },
        {
          "do": "lab",
          "op": "grime",
          "on": false
        },
        {
          "do": "lab",
          "op": "dynFrames",
          "frames": 240,
          "label": "ground switched off"
        },
        {
          "do": "camera",
          "target": "build",
          "view": "oblique",
          "pitch": 45,
          "shot": "45-off",
          "shotMode": "render"
        },
        {
          "do": "lab",
          "op": "grime",
          "on": true
        },
        {
          "do": "lab",
          "op": "grime",
          "focus": "rubbleSpread",
          "index": 3,
          "margin": 8
        },
        {
          "do": "camera",
          "target": "build",
          "view": "closeup",
          "distance": 30,
          "shot": "rubble",
          "shotMode": "render"
        },
        {
          "do": "lab",
          "op": "grime",
          "focus": "weedTufts",
          "index": 5,
          "margin": 6
        },
        {
          "do": "camera",
          "target": "build",
          "view": "closeup",
          "distance": 24,
          "shot": "weeds",
          "shotMode": "render"
        }
      ]
    },
