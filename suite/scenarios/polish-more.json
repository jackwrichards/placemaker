{
  "_about": "Neighbourhood polish beyond the four basic shapes: a very tight curve (R 30), a cul-de-sac (a dead-end street off a cross street; the game rounds its end), medium density, row houses, high density, low commercial, low-density houses levelled up after the polish (the new models must fit again), every third house bulldozed after it (nothing of theirs left standing), and polish switched on before a street grows with standing houses left alone (houses polished as they come). Before/after from above, one close-up each, and a dump of the houses for offline replays (Tests NeighbourReplay). Send with tools/hot/Send-Hot.ps1 -File suite/scenarios/polish-more.json (-Build after a mod change).",
  "scenarios": [
    {
      "id": "more-tight30",
      "land": {
        "shape": "rect",
        "size": [
          200,
          180
        ],
        "ground": "flat",
        "roads": "none"
      },
      "steps": [
        { "do": "lab", "op": "hotload", "path": "{hot}" },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "arc", "radius": 30, "from": 0, "to": 180 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "lab", "op": "polishStamp", "yes": true },
        { "do": "wait", "seconds": 4 },
        { "do": "lab", "op": "polishStats" },
        { "do": "lab", "op": "polishDump" },
        { "do": "shot", "name": "after-top", "camera": { "target": "area", "view": "top" },
          "shotMode": "render"
        },
        { "do": "shot", "name": "after-45", "camera": { "target": "point", "at": [ 0, 10 ], "view": "oblique", "pitch": 50, "distance": 100 },
          "shotMode": "render"
