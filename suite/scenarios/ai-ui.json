{
  "_about": "AI builder: the chat in the game (a picture of the screen while it works and when it is done) and the builds close up (handbook-10: paint strips, built decals, detail).",
  "scenarios": [
    {
      "id": "ai-ui-park",
      "land": {
        "shape": "rect",
        "size": [
          140,
          110
        ],
        "ground": "flat",
        "roads": "around",
        "gap": 10
      },
      "steps": [
        {
          "do": "setting",
          "name": "AiBuilderOn",
          "value": true
        },
        {
          "do": "setting",
          "name": "AiModel",
          "value": "anthropic/claude-sonnet-5.5"
        },
        {
          "do": "setting",
          "name": "AiThinking",
          "value": 1
        },
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "ai"
        },
        {
          "do": "aiAgent",
          "prompt": "A neighbourhood park.",
          "timeout": 900,
          "uiShotAfter": 25
        },
        {
          "do": "shot",
          "name": "chat-done",
          "shotMode": "ui"
        },
        {
          "do": "build"
        },
        {
          "do": "shot",
          "name": "45-built",
          "camera": {
            "target": "build",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "shot",
          "name": "close",
          "camera": {
            "target": "build",
            "view": "closeup"
          },
          "shotMode": "render"
        }
      ]
    },
    {
