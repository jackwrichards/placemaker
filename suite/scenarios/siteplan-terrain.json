{
  "_about": "Site plan: a park on hills (the Terrain row, the top view). Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/siteplan-terrain.json -Build -Who sketch-view",
  "scenarios": [
    {
      "id": "spperf-terrain-2",
      "pace": "settled",
      "land": {
        "shape": "rect",
        "size": [
          220,
          180
        ],
        "ground": "hills",
        "amplitude": 6,
        "gap": 10
      },
      "steps": [
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "park",
          "preset": "natural"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
        {
          "do": "previewMode",
          "mode": "sketch"
        },
        {
          "do": "wait",
          "seconds": 2
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "shot": "sketch-45",
          "shotMode": "overlay",
          "pitch": 45
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "shot": "review-ui",
          "shotMode": "ui",
          "pitch": 45
        }
      ]
    }
  ]
}