          "camera": {
            "target": "point",
            "at": [
              0,
              0
            ],
            "view": "top",
            "distance": 260
          }
        },
        {
          "do": "polish",
          "click": "polish-lens-on"
        },
        {
          "do": "polish",
          "click": "polish-city-tab-numbers",
