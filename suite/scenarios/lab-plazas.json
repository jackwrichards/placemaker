{
  "_about": "The plazas makeover (docs/runbooks/plazas.md): do the plaza kinds draw in the game? The lab lays them (and a shared grime strip and leaves to compare) on open flat ground, from above and close. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/lab-plazas.json -Who makeover-plazas",
  "scenarios": [
    {
      "id": "lab-plazas",
      "site": "flat",
      "pace": "settled",
      "land": { "size": [120, 120], "gap": 10 },
      "steps": [
        { "do": "camera", "target": "block", "view": "oblique" },
        { "do": "lab", "op": "library", "kinds": ["concreteStain", "gumField", "pavingGrimeStrip", "skateScuffs", "jointWeeds", "leafSquareSummer", "cafeStains", "bedSpillStrip", "kerbGrimeStrip", "leafMixedSummer"], "variants": 3, "cell": 8, "cols": 6, "at": [-24, 24] },
        { "do": "camera", "target": "build", "view": "top", "shot": "lab-top", "shotMode": "render" },
        { "do": "lab", "op": "library", "focus": "concreteStain", "margin": 1 },
        { "do": "camera", "target": "build", "view": "top", "shot": "lab-stain-top", "shotMode": "render" },
        { "do": "lab", "op": "library", "focus": "pavingGrimeStrip", "margin": 1 },
        { "do": "camera", "target": "build", "view": "top", "shot": "lab-grime-top", "shotMode": "render" },
        { "do": "lab", "op": "library", "focus": "leafSquareSummer", "margin": 1 },
        { "do": "camera", "target": "build", "view": "top", "shot": "lab-leaves-top", "shotMode": "render" }
      ]
    }
  ]
}
