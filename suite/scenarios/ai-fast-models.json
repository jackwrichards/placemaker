{
  "_about": "AI builder agent-12 on the fast models of OpenRouter (27 Oct): Gemini 3.8 Flash, Claude Haiku 5.5, GPT-6 Luna, DeepSeek V4.1 Flash, Qwen 3.8 Flash, MiniMax M3.1 Flash; medium thinking; three requests each.",
  "scenarios": [
    {
      "id": "fast-gemini-3-8-flash-beach",
      "land": {
        "shape": "rect",
        "size": [
          160,
          100
        ],
        "water": {
          "side": "north"
        },
        "roads": "around",
        "gap": 10
      },
      "steps": [
        {
          "do": "setting",
          "name": "AiBuilderOn",
          "value": true
        },
        {
          "do": "setting",
          "name": "AiThinking",
          "value": 1
        },
        {
          "do": "setting",
          "name": "AiModel",
          "value": "google/gemini-3.8-flash"
        },
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "ai"
        },
        {
          "do": "aiAgent",
          "prompt": "A beach.",
          "timeout": 1800
        },
        {
          "do": "build"
        },
        {
          "do": "grow",
          "seconds": 40
        },
        {
          "do": "shot",
          "name": "45-built",
          "camera": {
            "target": "build",
            "view": "oblique"
          },
          "shotMode": "render"
        },
        {
          "do": "shot",
          "name": "close",
          "camera": {
            "target": "build",
            "view": "closeup"
          },
          "shotMode": "render"
        }
      ]
    },
