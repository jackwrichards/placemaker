{
  "_about": "Site plan speed (the user, 25 Oct: lag in the sketch on a 3,573-space car park): a big car park in the sketch, Real and Classic, each followed by a 5 s wait whose frame times the step records; and a park on hills for the ground change row. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/siteplan-perf.json -Build -Who sketch-view",
  "scenarios": [
    {
      "id": "spperf-bigparking-t",
      "pace": "settled",
      "land": {
        "shape": "rect",
        "size": [
          460,
          340
        ],
        "gap": 10
      },
      "steps": [
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "parking",
          "preset": "standard"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
        {
          "do": "previewMode",
          "mode": "sketch"
        },
        {
          "do": "wait",
          "seconds": 2
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "shot": "sketch-45",
          "shotMode": "overlay",
          "pitch": 45
        },
        {
          "do": "wait",
          "seconds": 5
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "shot": "review-ui",
          "shotMode": "ui",
          "pitch": 45
        }
      ]
    }
  ]
}