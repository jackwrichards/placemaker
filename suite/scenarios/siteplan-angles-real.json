{
  "_about": "Site plan from three camera angles (the user, 25 Oct: the sketch changes with the camera; Real dark and broken): a rounded car park on a gentle slope, sketch and Real. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/siteplan-angles.json -Build -Who sketch-view",
  "scenarios": [
    {
      "id": "spang-real",
      "pace": "settled",
      "land": {
        "shape": "circle",
        "size": [
          300,
          240
        ],
        "ground": "slope",
        "grade": 4,
        "toward": "north",
        "gap": 10,
        "roads": "follow"
      },
      "steps": [
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "parking",
          "preset": "standard"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
        {
          "do": "previewMode",
          "mode": "sketch"
        },
        {
          "do": "wait",
          "seconds": 2
        },
        {
          "do": "previewMode",
          "mode": "ghost"
        },
        {
          "do": "wait",
          "seconds": 4
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "shot": "real-far",
          "shotMode": "overlay",
          "pitch": 50
        },
        {
          "do": "camera",
          "target": "area",
          "view": "low",
          "shot": "real-low",
          "shotMode": "overlay"
        },
        {
          "do": "camera",
          "target": "area",
          "view": "closeup",
          "shot": "real-close",
          "shotMode": "overlay"
        }
      ]
    }
  ]
}