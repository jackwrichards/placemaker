{
  "_about": "Ungroup dissolves a build for good (the user, 27 Oct: once ungrouped it is as if built by hand: no lot, no carrier, no record, no upkeep). One of each category built, audited (lab ungroupAudit: record, tags, carrier, owner lot, companions, our own lots in the city, hidden pieces), ungrouped from the info panel, audited again, then one tree / prop / stall marking bulldozed. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/ungroup-dissolve.json -Build -Who ungroup-dissolve",
  "scenarios": [
    {
      "id": "ug-park",
      "land": {
        "shape": "rect",
        "size": [
          140,
          120
        ],
        "gap": 10,
        "roads": "around"
      },
      "steps": [
        {
          "do": "area",
          "tool": "land"
        },
        {
          "do": "type",
          "layer": "park"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
        {
          "do": "build",
          "shot": "built"
        },
        {
          "do": "lab",
          "op": "ungroupAudit",
          "label": "built"
        },
        {
          "do": "infoUngroup",
          "ungroup": true
        },
        {
          "do": "wait",
          "frames": 60
        },
        {
          "do": "lab",
          "op": "ungroupAudit",
          "label": "ungrouped",
          "bulldoze": "tree"
        },
        {
          "do": "lab",
          "op": "ungroupAudit",
          "label": "ungrouped, a prop",
          "bulldoze": "prop"
        },
        {
          "do": "camera",
          "target": "area",
          "view": "oblique",
          "shot": "after"
        }
      ]
    },
