{
  "_about": "Neighbourhood polish (Game/Neighbours/NeighbourPolishSystem): houses grow on a curved and a straight street with the setting off, pictures; the setting goes on, the same pictures again; more growth, the counts again (rebuilt houses are re-stitched). Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/polish.json -Build -Who polish",
  "scenarios": [
    {
      "id": "polish-curve",
      "land": { "shape": "rect", "size": [380, 300], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "arc", "radius": 90, "from": 0, "to": 180 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-top", "camera": { "target": "area", "view": "top" }, "shotMode": "render" },
        { "do": "shot", "name": "before-outer", "camera": { "target": "point", "at": [0, 80], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" },
        { "do": "shot", "name": "before-outer2", "camera": { "target": "point", "at": [-60, 63], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" },
        { "do": "shot", "name": "before-inner", "camera": { "target": "point", "at": [0, 18], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" },
        { "do": "lab", "op": "polishParts", "parts": "lines" },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "wait", "seconds": 3 },
        { "do": "lab", "op": "polishStats" },
        { "do": "shot", "name": "lines-only-top", "camera": { "target": "area", "view": "top" }, "shotMode": "render" },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "polishParts", "parts": "both" },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "wait", "seconds": 3 },
        { "do": "lab", "op": "polishStats" },
        { "do": "shot", "name": "after-top", "camera": { "target": "area", "view": "top" }, "shotMode": "render" },
        { "do": "shot", "name": "after-outer", "camera": { "target": "point", "at": [0, 80], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" },
        { "do": "shot", "name": "after-outer2", "camera": { "target": "point", "at": [-60, 63], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" },
        { "do": "shot", "name": "after-inner", "camera": { "target": "point", "at": [0, 18], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" },
        { "do": "grow", "seconds": 40 },
        { "do": "lab", "op": "polishStats" },
        { "do": "shot", "name": "after-grow-top", "camera": { "target": "area", "view": "top" }, "shotMode": "render" }
      ]
    },
    {
      "id": "polish-straight",
      "land": { "shape": "rect", "size": [300, 220], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "setting", "name": "NeighbourhoodPolish", "value": false },
        { "do": "lab", "op": "street", "shape": "straight", "length": 240 },
        { "do": "grow", "seconds": 120 },
        { "do": "shot", "name": "before-45", "camera": { "target": "point", "at": [-20, 32], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" },
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "wait", "seconds": 3 },
        { "do": "lab", "op": "polishStats" },
        { "do": "shot", "name": "after-45", "camera": { "target": "point", "at": [-20, 32], "view": "oblique", "pitch": 45, "distance": 85 }, "shotMode": "render" }
      ]
    }
  ]
}
